---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import MyContacts from '../components/MyContacts.astro';

const entry = await getEntry('pages', 'aide');
if (!entry) throw new Error('src/content/pages/aide.md est introuvable');
const { Content } = await render(entry);
---

<Base title={entry.data.title}>
  <div class="aide">
    <h1>{entry.data.title}</h1>
    <MyContacts />
    <Content />
  </div>
</Base>
