---
import '../styles/global.css';
import { url } from '../lib/url';
import CrisisButton from '../components/CrisisButton.astro';

interface Props {
  title: string;
  description?: string;
  // true sur la page trousse : le bouton fixe devient « Retour ».
  isTrousse?: boolean;
}

const {
  title,
  description = 'Des outils simples pour traverser les moments d’anxiété.',
  isTrousse = false,
} = Astro.props;
const siteName = 'Traverser la vague';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// Service worker (hors ligne) : seulement sur le site construit, pas en développement.
const sw = { src: url('sw.js'), scope: url() };
const registerSw = import.meta.env.PROD;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <!-- Thème « jour » par défaut, quel que soit le réglage du téléphone. Mode nuit = option manuelle. -->
    <meta name="theme-color" content="#fffaf2" />
    <meta name="color-scheme" content="light" />
    <!-- Avant l'affichage, pour éviter un flash clair si le mode nuit a été choisi. Sans JS : clair. -->
    <script is:inline>
      try {
        if (localStorage.getItem('vague-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').content = '#1b201e';
        }
      } catch (e) {}
    </script>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="wrap">
        <a class="home-link" href={url()}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 11.5 12 4l9 7.5" />
            <path d="M5.5 10v9.5h13V10" />
          </svg>
          {siteName}
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
          <a href={url('journal/')}>Journal</a>
        </nav>
      </div>
    </header>
    <!-- Juste après l'en-tête : atteint tôt au clavier ; affiché fixe en bas d'écran. -->
    <nav aria-label={isTrousse ? 'Retour' : 'Trousse de crise'}>
      <CrisisButton back={isTrousse} />
    </nav>
    <main id="contenu" class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>Un petit guide personnel. Prends ce qui t’aide, laisse le reste.</p>
      <button type="button" class="theme-toggle" aria-pressed="false" data-theme-toggle hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
        </svg>
        <span>Mode nuit</span>
      </button>
    </footer>
    <script is:inline>
      // Interrupteur « Mode nuit » : choix mémorisé dans ce navigateur seulement.
      (function () {
        var btn = document.querySelector('[data-theme-toggle]');
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        function apply(dark) {
          if (dark) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          meta.content = dark ? '#1b201e' : '#fffaf2';
          btn.setAttribute('aria-pressed', String(dark));
        }
        apply(root.dataset.theme === 'dark');
        btn.hidden = false;
        btn.addEventListener('click', function () {
          var dark = root.dataset.theme !== 'dark';
          apply(dark);
          try {
            if (dark) localStorage.setItem('vague-theme', 'dark');
            else localStorage.removeItem('vague-theme');
          } catch (e) {}
        });
      })();
    </script>
    {
      registerSw && (
        <script is:inline define:vars={{ sw }}>
          if ('serviceWorker' in navigator) {
            addEventListener('load', () => {
              navigator.serviceWorker.register(sw.src, { scope: sw.scope }).catch(() => {});
            });
          }
        </script>
      )
    }
  </body>
</html>
