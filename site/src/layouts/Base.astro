---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Des outils simples pour traverser les moments d’anxiété.' } = Astro.props;
const siteName = 'Traverser la vague';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b201e" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="wrap">
        <a class="home-link" href={url()}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 11.5 12 4l9 7.5" />
            <path d="M5.5 10v9.5h13V10" />
          </svg>
          {siteName}
        </a>
      </div>
    </header>
    <main id="contenu" class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>Un petit guide personnel. Prends ce qui t’aide, laisse le reste.</p>
    </footer>
  </body>
</html>
