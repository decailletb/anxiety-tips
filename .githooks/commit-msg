#!/bin/sh
# Rejects commit messages that are not Angular-style or that contain
# AI attribution / tool mentions (forbidden in this repo).

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Allow git-generated merge/revert subjects only if they follow the convention too.
if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|test|chore|refactor|style|ci|build|perf)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "commit-msg: subject must follow Angular format: type(scope): description" >&2
  echo "  got: $first_line" >&2
  exit 1
fi

if grep -Eiq 'claude|anthropic|co-authored-by|generated with' "$msg_file"; then
  echo "commit-msg: attribution or forbidden tool mention found in message." >&2
  exit 1
fi

exit 0
